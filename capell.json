{
    "manifest-version": 3,
    "name": "capell-app/site-stats",
    "slug": "site-stats",
    "displayName": "Site Stats",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Site Stats provides privacy-safe page, site, and active domain totals through Capell's typed metrics pipeline.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\SiteStats",
    "surfaces": ["shared"],
    "dependencies": {
        "requires": ["capell-app/core"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\SiteStats\\Providers\\SiteStatsServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "health-check",
            "class": "Capell\\SiteStats\\Health\\SiteStatsHealthCheck"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": ["pages", "sites", "site_domains"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": [],
    "settings": [],
    "permissions": [],
    "capabilities": ["privacy-safe-content-metrics"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 2,
        "cacheTags": ["site-stats"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "site-stats.metrics-collector",
            "label": "Site Stats collector registration is available.",
            "class": "Capell\\SiteStats\\Health\\SiteStatsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Privacy-safe page, site, and active domain totals and trends built on Capell's typed metrics pipeline.",
        "description": "Registers current-day global page, site, active site, and active domain totals with Capell's shared typed metrics pipeline. Site Stats owns no dashboard or public UI; installed Core metrics consumers can display the retained daily series.",
        "screenshots": [],
        "categories": ["foundation", "analytics"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "runtimeIntegrations": {
            "metricCollectors": [
                "Capell\\SiteStats\\Metrics\\ContentTotalsMetricsCollector"
            ]
        }
    }
}
